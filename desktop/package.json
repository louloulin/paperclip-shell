{
  "name": "@paperclipai/desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Paperclip desktop shell (Electron). Standalone: consumes a Paperclip checkout as a build input.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "stage": "node scripts/stage-server.mjs",
    "preflight": "node scripts/preflight-runtime.mjs",
    "probe": "node scripts/probe.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "package:mac": "node scripts/package.mjs --mac",
    "package:mac:both": "node scripts/package.mjs --mac --arm64 --x64",
    "package:win": "node scripts/package.mjs --win",
    "package:linux": "node scripts/package.mjs --linux",
    "verify": "node scripts/verify-shell.mjs",
    "verify:dev": "node scripts/verify-shell.mjs --dev",
    "icons": "electron scripts/make-icons.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
